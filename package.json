{
  "name": "3dvista-assistant",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "server"
  ],
  "scripts": {
    "build:core": "npm run build -ws --if-present",
    "build:bundle": "node scripts/build-tour-bundle.mjs demo-showroom",
    "inject:widget": "node scripts/inject-widget.mjs demo-showroom",
    "validate:catalog": "tsx scripts/validate-catalog.mjs demo-showroom",
    "xlsx:demo-showroom": "node scripts/xlsx-to-json.mjs demo-showroom",
    "server:dev": "npm run dev -w server",
    "serve:demo": "node scripts/serve-demo.mjs"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.2"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
