# Copiar a server/.env y completar con la clave real. server/.env está en .gitignore — nunca se commitea.
# Este backend corresponde a UN tour (demo-showroom) — recuerda que en producción cada tour/cliente
# final tiene su propio despliegue de este mismo template, cada uno con su propio .env.

PORT=8787
# "openai" (default) or "anthropic" — see orchestrator.ts. Only the matching
# key below is required; keep both set here and override MODEL_PROVIDER/
# MODEL_ID/PORT at the shell level per-instance to run several backends
# (one per provider/model) from this same checkout at once.
MODEL_PROVIDER=openai
OPENAI_API_KEY=sk-REPLACE-ME
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
MODEL_ID=gpt-4o-mini

TOUR_ID=demo-showroom
ALLOWED_ORIGIN=http://localhost:5500

USAGE_LOG_PATH=./data/usage.jsonl

# --- Moodboard de la wishlist (docs/moodboard/README.md) --------------
# Genera siempre con OPENAI_API_KEY, sea cual sea MODEL_PROVIDER. Todo es
# opcional: estos son los valores por defecto. Los modelos se fijan aqui,
# nunca desde el navegador.
# MOODBOARD_ENABLED=true
# MOODBOARD_ANALYSIS_MODEL=gpt-5.6-luna
# MOODBOARD_ANALYSIS_REASONING=low          # "default" = no enviarlo (obligatorio con modelos sin razonamiento, p. ej. gpt-4o-mini)
# MOODBOARD_TEXTURE_SIMPLE=gpt-image-1-mini:low
# MOODBOARD_TEXTURE_COMPLEX=gpt-image-1.5:low
# MOODBOARD_CACHE_DIR=./data/moodboards
# MOODBOARD_USAGE_LOG_PATH=./data/moodboard-usage.jsonl
# MOODBOARD_DAILY_LIMIT=300                 # generaciones nuevas por dia (las cacheadas no cuentan)
# MOODBOARD_SESSION_HOURLY_LIMIT=6          # generaciones nuevas por visitante y hora
# MOODBOARD_BRAND=                          # por defecto: assistantName del tour sin "Assistente"
