# Copiar a server/.env y completar con la clave real. server/.env está en .gitignore — nunca se commitea.
# Este backend corresponde a UN tour (demo-showroom) — recuerda que en producción cada tour/cliente
# final tiene su propio despliegue de este mismo template, cada uno con su propio .env.

PORT=8787
OPENAI_API_KEY=sk-REPLACE-ME
MODEL_ID=gpt-4o-mini

TOUR_ID=demo-showroom
ALLOWED_ORIGIN=http://localhost:5500

USAGE_LOG_PATH=./data/usage.jsonl
